# ==========================================================================
# Market Mood 3 — 환경변수 예시
#
# 이 파일을 .env.local 로 복사해서 사용하세요.  cp .env.example .env.local
#
# ★ 중요: 모든 키는 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#         붙이면 브라우저 번들에 그대로 포함되어 키가 노출됩니다.
# ==========================================================================

# --------------------------------------------------------------------------
# 동작 모드
#   auto (기본) : MACRO_API_KEY 가 있으면 LIVE, 없으면 DEMO
#                 (코드가 실제로 읽는 키는 이 하나뿐입니다. 나머지는 없어도 켜집니다)
#   demo        : 항상 DEMO (고정 샘플 데이터)
#   live        : 항상 LIVE (키가 없으면 해당 섹션이 오류로 표시됨)
#
# DEMO 와 LIVE 데이터는 절대 섞이지 않습니다. 모드는 스냅샷 단위로 하나입니다.
#
# ⚠ 이 파일을 Vercel 같은 배포 환경변수로 옮겨 적을 때 demo 로 두면
#   MACRO_API_KEY 를 넣어도 예시 데이터만 나옵니다. 그래서 기본값을 auto 로 둡니다.
# --------------------------------------------------------------------------
MARKET_MOOD_MODE=auto

# --------------------------------------------------------------------------
# 시장 데이터 제공사 키 (LIVE 모드 필수)
#   실제 연결 지점: src/server/adapters/live/index.ts
#   연결 점검:      npm run check:live  (제공사마다 실제로 불러 보고 결과를 보여줍니다)
# --------------------------------------------------------------------------
# --- 크립토 : CoinGecko + Binance --- [연결 완료]
# 키가 없어도 동작합니다. 무료 Demo 키를 넣으면 분당 한도가 올라갑니다.
#   키 발급(선택): https://www.coingecko.com/en/api/pricing
CRYPTO_API_KEY=
CRYPTO_BASE_URL=
# 펀딩비·미결제약정 (Binance 공개 API, 키 불필요)
CRYPTO_DERIV_BASE_URL=

# --- 거시·환율 : FRED --- [연결 완료]
# 무료 키를 발급받아 넣으세요. VIX·하이일드 스프레드·장단기 금리차·원달러·CPI 등.
#   키 발급: https://fred.stlouisfed.org/docs/api/api_key.html
MACRO_API_KEY=
MACRO_BASE_URL=

# --- 미국·한국 시세 : Yahoo Finance --- [연결 완료]
# 키가 필요 없습니다. 지수 · 미국 종목 · 한국 지수 · 한국 종목 · 환율 · 원자재를
# 한 곳에서 줍니다. 지연은 거래소마다 다르고, 화면에는 더 느린 쪽에 맞춰
# '15분 지연' 이라고 적습니다.
#
# ※ 2026-09: 원래 Stooq 를 썼는데 제공사가 문을 닫았습니다.
#    stooq.com/q/l/ → 404, stooq.com/q/d/l/ → Access denied.
#    자세한 기록은 src/server/adapters/live/providers/stooq.ts 머리말에 있습니다.
#
# ⚠ Yahoo 가 문서로 공개한 API 가 아니라 웹 화면이 쓰는 주소입니다.
#    개인적·비상업적 범위에서 쓰고, 값을 재배포하지 않습니다.
#    상업적으로 쓸 일이 생기면 정식 계약이 있는 곳(Twelve Data · Finnhub 등)으로
#    옮겨야 합니다 — providers/yahoo.ts 의 심볼 표만 바꾸면 됩니다.
#
# US_MARKET_API_KEY 는 코드가 읽지 않습니다. 유료 제공사로 갈아탈 때를 위한 자리입니다.
US_MARKET_API_KEY=
US_MARKET_BASE_URL=

# --- 미국 풋/콜 : Cboe --- [연결 완료]
# 키가 필요 없습니다. 일별 마감 통계 CSV 입니다.
# 미국 심리 점수의 14% 를 이것이 채웁니다 — 빠지면 57% 가 되어 70% 문턱을 못 넘습니다.
CBOE_CSV_URL=

# --- 선물 정산가 : EIA (미국 에너지정보청) --- [연결 완료 · 선택]
# 무료 키입니다. 이메일만 넣으면 바로 나옵니다.
#   키 발급: https://www.eia.gov/opendata/
#
# 이 앱에서 **진짜 선물 계약 값**이 실리는 유일한 자리입니다.
# 지수·금속·농산물 선물은 거래소(CME·ICE)가 파는 시세라 무료로 재배포할 수 없지만,
# 에너지 넷(WTI 원유·천연가스·난방유·RBOB 휘발유)은 미국 정부가 NYMEX 인도월
# 정산가를 공개 통계로 내고 재배포 제한이 없습니다.
# 인도월 1~4를 함께 받아 콘탱고·백워데이션(먼 달이 비싼가)까지 보여줍니다.
#
# 키가 없어도 앱은 돕니다.
#   · 원유·천연가스 → FRED 현물 가격으로 대체 ('대신 쓴 값' 표시가 붙습니다)
#   · 난방유·휘발유 → 사유와 함께 빕니다
#
# ⚠ 응답 모양과 계열 코드는 EIA 문서를 따른 것이고 실제 응답으로 확인하지 못했습니다.
#   키를 넣고 `npm run check:live` 를 돌리면 실제 열 이름을 그대로 찍어 줍니다.
EIA_API_KEY=
EIA_BASE_URL=

# --- 미국 상장사 재무제표 : SEC EDGAR --- [연결 완료]
# 키가 필요 없습니다. 미국 증권거래위원회가 상장사 공시를 기계가 읽는 형태(XBRL)로
# 전부 공개하고, 연방정부 저작물이라 재배포 제한도 없습니다.
# 유료 벤더가 파는 '재무 데이터' 의 원본이 대체로 이것입니다.
#
# ★ SEC 는 **연락처가 담긴 User-Agent** 를 요구합니다. 없으면 403 으로 막습니다.
#   운영에 올릴 때는 실제로 닿는 주소로 바꾸세요. 이건 약관이라기보다 접속 조건입니다.
#   예: SEC_USER_AGENT=MarketMood3/1.0 (contact: you@example.com)
SEC_USER_AGENT=
SEC_BASE_URL=
#
# ⚠ 응답 모양은 SEC 문서를 따른 것이고 실제 응답으로 확인하지 못했습니다.
#   `npm run check:live` 가 실제 응답의 열 이름과 태그를 그대로 찍어 줍니다.

# --- 한국 투자자 수급 --- [미연결]
# KR_MARKET_API_KEY 도 코드가 읽지 않습니다. 연결할 때를 위한 자리입니다.
# 무료 실시간 소스가 없습니다. KRX·공공데이터포털은 일별 마감 데이터라
# 심리 점수의 문턱(70%)을 넘지 못해, 한국은 시장에서 빼고 지수만 남겼습니다.
KR_MARKET_API_KEY=
KR_MARKET_BASE_URL=

# --- 생활 경제 지수 : 세계은행 + 이코노미스트 --- [연결 완료]
# 둘 다 키가 필요 없습니다. 비워 두면 아래 기본 주소를 씁니다.
#   세계은행   1인당 GDP · 지니계수 · 물가 · 실업률 · PPP · 환율 · 합계출산율 (연 1회)
#   이코노미스트 빅맥지수 CSV (연 2회, GitHub 공개 저장소)
#   가계부채 비율은 IMF 값을 FRED 로 받습니다 — 위 MACRO_API_KEY 를 그대로 씁니다.
# 열한 지수 가운데 일곱이 실데이터입니다. 엥겔계수·PIR·OECD 경기선행지수·
# 소비자심리지수는 무료 API 가 없거나 기관마다 정의가 달라 넣지 않았습니다.
WORLDBANK_BASE_URL=
BIGMAC_CSV_URL=

# --- 경제 캘린더 : FRED 발표 일정 --- [연결 완료]
# 위 MACRO_API_KEY 를 그대로 씁니다. 따로 발급받을 것이 없습니다.
# 미국 주요 지표(CPI·고용보고서·GDP·PCE 등)의 발표 예정일을 받아옵니다.
#   · 날짜만 옵니다. 발표 시각은 주지 않아 화면에 "시각 미정" 으로 뜹니다.
#   · 예상치·이전값도 주지 않습니다. 지어내지 않고 비웁니다.
#   · 한국·크립토 일정은 이 소스에 없습니다.
#   · FOMC 회의는 분기별 경제전망요약(SEP)이 나오는 네 번만 잡힙니다.
#     연준이 회의 일정표를 기계가 읽을 수 있는 형태로 공개하지 않습니다.
# 어떤 발표가 실제로 잡히는지는 `npm run check:live` 가 원문 이름으로 보여줍니다.
CALENDAR_API_KEY=
CALENDAR_BASE_URL=

# --- 뉴스 --- [미연결]
NEWS_API_KEY=
NEWS_BASE_URL=

# --------------------------------------------------------------------------
# 업스트림 호출 정책 (선택 — 기본값 사용 권장)
# --------------------------------------------------------------------------
# 외부 API 타임아웃(ms)
UPSTREAM_TIMEOUT_MS=6000
# 재시도 횟수 (지수 백오프 + 지터)
UPSTREAM_MAX_RETRIES=2
# 업스트림 호스트당 초당 최대 요청 수
UPSTREAM_RATE_LIMIT_PER_SEC=5
# 클라이언트 IP 당 분당 최대 API 요청 수
CLIENT_RATE_LIMIT_PER_MIN=120

# --------------------------------------------------------------------------
# 쫄탐광장 (다음 거래일 맞히기 · 한 줄 토론) 저장소 — 선택
# --------------------------------------------------------------------------
# 비워 두면 서버 메모리에 둡니다. 서버(인스턴스)가 다시 뜨면 기록이 사라지고,
# 화면에 "기록이 오래 남지 않는다" 고 적힙니다.
# 오래 남기려면 Vercel → 프로젝트 → Storage(또는 Marketplace) 에서 Upstash Redis 를 연결하세요.
# 연결하면 아래 한 쌍(또는 KV_REST_API_URL / KV_REST_API_TOKEN)이 자동으로 들어옵니다.
# 토큰은 서버에서만 읽습니다. NEXT_PUBLIC_ 을 붙이지 마세요. 무료 등급은 하루 사용량 한도가 있습니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 한 줄 토론 관리자 삭제 키 (16자 이상, 비워 두면 관리자 삭제는 꺼짐 — 신고 3번 가림은 그대로 동작)
# 삭제: POST /api/plaza {"action":"delete","id":"글 번호"} + 머리글 x-plaza-admin: <이 값>
PLAZA_ADMIN_KEY=

# --------------------------------------------------------------------------
# 쫄탐광장 로그인 — 카카오만 (2026-11-26)
# --------------------------------------------------------------------------
# 비워 두면 '카카오 로그인' 단추가 잠기고 "아직 설정되지 않았어요" 라고 뜹니다(DEMO 에서는 연습 로그인만 열림).
# 1) https://developers.kakao.com → 내 애플리케이션 → 애플리케이션 추가
# 2) 앱 키 → REST API 키 → 아래 KAKAO_REST_API_KEY
# 3) 카카오 로그인 → 활성화 ON, Redirect URI 에  https://(배포 주소)/api/auth/kakao/callback  등록
#    (Vercel 미리보기 주소도 쓰려면 그 주소도 함께 등록 — 여러 개 등록할 수 있습니다)
# 4) 보안 → Client Secret 코드 생성 · 활성화 → 아래 KAKAO_CLIENT_SECRET
# 5) 동의항목: 닉네임(필수). 실명(이름)은 비즈 앱(개인 개발자 비즈 앱) 전환 뒤 심사를 받아야 열립니다.
#    심사 때 개인정보 처리방침 주소로  https://(배포 주소)/privacy  를 적습니다.
#    이름 항목이 열리기 전에는 카카오 닉네임을, 열린 뒤에는 이름을 가운데 가려(김*수) 보여 줍니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 비워 두면 지금 주소 + /api/auth/kakao/callback 을 씁니다. 주소가 여럿이라 헷갈리면 하나로 못박으세요.
KAKAO_REDIRECT_URI=
# 로그인 쿠키 서명 키 — 32자 이상 무작위 문자열(비밀번호 생성기로 만드세요). 없으면 LIVE 로그인이 꺼집니다.
AUTH_SECRET=
# 개인정보 처리방침의 문의처 (예: 이메일). 비밀값이 아닙니다.
PLAZA_CONTACT=
