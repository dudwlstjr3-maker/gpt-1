# ==========================================================================
# Market Mood 3 — 환경변수 예시
#
# 이 파일을 .env.local 로 복사해서 사용하세요.  cp .env.example .env.local
#
# ★ 중요: 모든 키는 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#         붙이면 브라우저 번들에 그대로 포함되어 키가 노출됩니다.
# ==========================================================================

# --------------------------------------------------------------------------
# 동작 모드
#   auto (기본) : MACRO_API_KEY 가 있으면 LIVE, 없으면 DEMO
#                 (코드가 실제로 읽는 키는 이 하나뿐입니다. 나머지는 없어도 켜집니다)
#   demo        : 항상 DEMO (고정 샘플 데이터)
#   live        : 항상 LIVE (키가 없으면 해당 섹션이 오류로 표시됨)
#
# DEMO 와 LIVE 데이터는 절대 섞이지 않습니다. 모드는 스냅샷 단위로 하나입니다.
# --------------------------------------------------------------------------
MARKET_MOOD_MODE=demo

# --------------------------------------------------------------------------
# 시장 데이터 제공사 키 (LIVE 모드 필수)
#   실제 연결 지점: src/server/adapters/live/index.ts
#   연결 점검:      npm run check:live  (제공사마다 실제로 불러 보고 결과를 보여줍니다)
# --------------------------------------------------------------------------
# --- 크립토 : CoinGecko + Binance --- [연결 완료]
# 키가 없어도 동작합니다. 무료 Demo 키를 넣으면 분당 한도가 올라갑니다.
#   키 발급(선택): https://www.coingecko.com/en/api/pricing
CRYPTO_API_KEY=
CRYPTO_BASE_URL=
# 펀딩비·미결제약정 (Binance 공개 API, 키 불필요)
CRYPTO_DERIV_BASE_URL=

# --- 거시·환율 : FRED --- [연결 완료]
# 무료 키를 발급받아 넣으세요. VIX·하이일드 스프레드·장단기 금리차·원달러·CPI 등.
#   키 발급: https://fred.stlouisfed.org/docs/api/api_key.html
MACRO_API_KEY=
MACRO_BASE_URL=

# --- 미국·한국 지수 시세 : Stooq --- [연결 완료]
# 키가 필요 없습니다. 실시간이 아니라 15분 안팎 지연된 값입니다 —
# 화면에도 '15분 지연' 이라고 그대로 적습니다.
# US_MARKET_API_KEY 는 코드가 읽지 않습니다. 유료 제공사로 갈아탈 때를 위한 자리입니다.
US_MARKET_API_KEY=
US_MARKET_BASE_URL=

# --- 미국 풋/콜 : Cboe --- [연결 완료]
# 키가 필요 없습니다. 일별 마감 통계 CSV 입니다.
# 미국 심리 점수의 14% 를 이것이 채웁니다 — 빠지면 57% 가 되어 70% 문턱을 못 넘습니다.
CBOE_CSV_URL=

# --- 한국 투자자 수급 --- [미연결]
# KR_MARKET_API_KEY 도 코드가 읽지 않습니다. 연결할 때를 위한 자리입니다.
# 무료 실시간 소스가 없습니다. KRX·공공데이터포털은 일별 마감 데이터라
# 심리 점수의 문턱(70%)을 넘지 못해, 한국은 시장에서 빼고 지수만 남겼습니다.
KR_MARKET_API_KEY=
KR_MARKET_BASE_URL=

# --- 생활 경제 지수 : 세계은행 + 이코노미스트 --- [연결 완료]
# 둘 다 키가 필요 없습니다. 비워 두면 아래 기본 주소를 씁니다.
#   세계은행   1인당 GDP · 지니계수 · 물가 · 실업률 · PPP · 환율 (연 1회)
#   이코노미스트 빅맥지수 CSV (연 2회, GitHub 공개 저장소)
# 아홉 지수 가운데 다섯만 여기서 옵니다. 엥겔계수·PIR·OECD 경기선행지수·
# 소비자심리지수는 무료 API 가 없거나 기관마다 정의가 달라 넣지 않았습니다.
WORLDBANK_BASE_URL=
BIGMAC_CSV_URL=

# --- 경제 캘린더 : FRED 발표 일정 --- [연결 완료]
# 위 MACRO_API_KEY 를 그대로 씁니다. 따로 발급받을 것이 없습니다.
# 미국 주요 지표(CPI·고용보고서·GDP·PCE 등)의 발표 예정일을 받아옵니다.
#   · 날짜만 옵니다. 발표 시각은 주지 않아 화면에 "시각 미정" 으로 뜹니다.
#   · 예상치·이전값도 주지 않습니다. 지어내지 않고 비웁니다.
#   · 한국·크립토 일정은 이 소스에 없습니다.
#   · FOMC 회의는 분기별 경제전망요약(SEP)이 나오는 네 번만 잡힙니다.
#     연준이 회의 일정표를 기계가 읽을 수 있는 형태로 공개하지 않습니다.
# 어떤 발표가 실제로 잡히는지는 `npm run check:live` 가 원문 이름으로 보여줍니다.
CALENDAR_API_KEY=
CALENDAR_BASE_URL=

# --- 뉴스 --- [미연결]
NEWS_API_KEY=
NEWS_BASE_URL=

# --------------------------------------------------------------------------
# 업스트림 호출 정책 (선택 — 기본값 사용 권장)
# --------------------------------------------------------------------------
# 외부 API 타임아웃(ms)
UPSTREAM_TIMEOUT_MS=6000
# 재시도 횟수 (지수 백오프 + 지터)
UPSTREAM_MAX_RETRIES=2
# 업스트림 호스트당 초당 최대 요청 수
UPSTREAM_RATE_LIMIT_PER_SEC=5
# 클라이언트 IP 당 분당 최대 API 요청 수
CLIENT_RATE_LIMIT_PER_MIN=120
