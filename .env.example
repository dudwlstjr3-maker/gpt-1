# ==========================================================================
# Market Mood 3 — 환경변수 예시
#
# 이 파일을 .env.local 로 복사해서 사용하세요.  cp .env.example .env.local
#
# ★ 중요: 모든 키는 서버에서만 읽습니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
#         붙이면 브라우저 번들에 그대로 포함되어 키가 노출됩니다.
# ==========================================================================

# --------------------------------------------------------------------------
# 동작 모드
#   auto (기본) : 아래 필수 키가 모두 있으면 LIVE, 하나라도 없으면 DEMO
#   demo        : 항상 DEMO (고정 샘플 데이터)
#   live        : 항상 LIVE (키가 없으면 해당 섹션이 오류로 표시됨)
#
# DEMO 와 LIVE 데이터는 절대 섞이지 않습니다. 모드는 스냅샷 단위로 하나입니다.
# --------------------------------------------------------------------------
MARKET_MOOD_MODE=demo

# --------------------------------------------------------------------------
# 시장 데이터 제공사 키 (LIVE 모드 필수)
#   실제 연결 지점: src/server/adapters/live/index.ts
# --------------------------------------------------------------------------
# 미국 시세·지수·옵션 통계
US_MARKET_API_KEY=
US_MARKET_BASE_URL=

# 한국 시세·투자자 수급 (예: KRX 정보데이터시스템 / 증권사 API)
KR_MARKET_API_KEY=
KR_MARKET_BASE_URL=

# 크립토 시세·도미넌스·파생 (예: CoinGecko, 거래소 공개 API)
CRYPTO_API_KEY=
CRYPTO_BASE_URL=

# 거시 지표 (예: FRED, 한국은행 ECOS)
MACRO_API_KEY=
MACRO_BASE_URL=

# 선택: 경제 캘린더 / 뉴스
CALENDAR_API_KEY=
CALENDAR_BASE_URL=
NEWS_API_KEY=
NEWS_BASE_URL=

# --------------------------------------------------------------------------
# 업스트림 호출 정책 (선택 — 기본값 사용 권장)
# --------------------------------------------------------------------------
# 외부 API 타임아웃(ms)
UPSTREAM_TIMEOUT_MS=6000
# 재시도 횟수 (지수 백오프 + 지터)
UPSTREAM_MAX_RETRIES=2
# 업스트림 호스트당 초당 최대 요청 수
UPSTREAM_RATE_LIMIT_PER_SEC=5
# 클라이언트 IP 당 분당 최대 API 요청 수
CLIENT_RATE_LIMIT_PER_MIN=120
