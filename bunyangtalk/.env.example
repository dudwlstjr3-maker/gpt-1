# PostgreSQL 연결 문자열 (로컬 개발 예시 — 운영에서는 비밀 값으로 주입)
DATABASE_URL=postgres://bt:bt_local_dev@localhost:5432/bunyangtalk

# 결제 제공자: mock(시연용, 실제 결제 없음) | toss(미구현 — 가맹 계약 후 연동)
PAYMENT_PROVIDER=mock

# 1이면 화면 상단에 "시연용 데이터" 안내 띠를 표시
DEMO_MODE=1

# 채팅 메시지 보관 기간(일). 신고 처리 중인 메시지는 처리 후 90일까지 보존
CHAT_RETENTION_DAYS=180
