{
  "name": "bunyangtalk",
  "version": "0.1.0",
  "private": true,
  "description": "분양톡 — 분양업계 종사자 커뮤니티·구인구직 플랫폼 (MVP)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/migrate.mjs --reset && node scripts/seed.mjs",
    "db:retention": "node scripts/retention.mjs",
    "test:api": "node --test tests/api.test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "pg": "^8.13.1",
    "pretendard": "1.3.9",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
